{
  "name": "@mixte/monorepo",
  "type": "module",
  "version": "3.6.1",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "实用工具函数/Vue 组合式函数/工具向 Vue 组件/常用校验函数/一些代码片段 - Utilities/Vue composable/Vue utility components/Validator/Code snippet",
  "author": "Wei Zhang <https://github.com/Zhang-Wei-666>",
  "license": "MIT",
  "homepage": "https://github.com/MoomFE/mixte#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoomFE/mixte.git"
  },
  "bugs": {
    "url": "https://github.com/MoomFE/mixte/issues"
  },
  "keywords": [
    "utilities",
    "vue",
    "composables",
    "vue-composables",
    "components",
    "vue-components",
    "validator",
    "snippets"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.18.0 || >=26.0.0"
  },
  "scripts": {
    "test": "pnpm install && vitest watch --coverage",
    "test:ui": "cross-env Browser_UI=true pnpm test",
    "test-build": "pnpm build && vitest watch --mode test-build",
    "test-build:ui": "cross-env Browser_UI=true pnpm test-build",
    "test-release": "pnpm test-tsc && pnpm test-build --run",
    "test-coverage": "pnpm install && vitest --run",
    "test-tsc": "pnpm install && vitest --run && vue-tsc --project tsconfig.tsc.json --noEmit",
    "dev": "pnpm docs:dev --port 1292",
    "docs:dev": "pnpm udd && vitepress dev packages --host",
    "docs:build": "pnpm udd && pnpm build && vitepress build packages",
    "docs:preview": "pnpm docs:build && vitepress preview packages --host",
    "up": "npx taze latest -r -w -i -x",
    "lint": "pnpm install && eslint .",
    "lint:fix": "pnpm lint --fix",
    "udd": "pnpm install && tsx scripts/updateDocsDetails.ts",
    "build": "pnpm install && pnpm --workspace-concurrency=Infinity -r --filter=./packages/* run build",
    "release": "pnpm test-release && npx bumpp -r --no-tag --no-push",
    "postinstall": "pnpm exec simple-git-hooks && pnpm exec playwright install chromium"
  },
  "devDependencies": {
    "@arco-design/web-vue": "catalog:",
    "@floating-ui/vue": "catalog:",
    "@iconify/json": "catalog:",
    "@mixte/components": "workspace:*",
    "@mixte/snippets": "workspace:*",
    "@mixte/use": "workspace:*",
    "@mixte/validator": "workspace:*",
    "@moomfe/eslint-config": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@rollup/pluginutils": "catalog:",
    "@shikijs/vitepress-twoslash": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/postcss-js": "catalog:",
    "@types/three": "catalog:",
    "@vercel/analytics": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vue/compiler-core": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "catalog:",
    "axios": "catalog:",
    "chalk": "catalog:",
    "cheerio": "catalog:",
    "cross-env": "catalog:",
    "element-plus": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "fast-glob": "catalog:",
    "fs-extra": "catalog:",
    "gsap": "catalog:",
    "is-in-ci": "catalog:",
    "js-base64": "catalog:",
    "js-yaml": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "lodash-es": "catalog:",
    "magic-string": "catalog:",
    "mixte": "workspace:*",
    "naive-ui": "catalog:",
    "nanoid": "catalog:",
    "nuxt": "catalog:",
    "ora": "catalog:",
    "pathe": "catalog:",
    "playwright": "catalog:",
    "pnpm": "catalog:",
    "postcss": "catalog:",
    "postcss-js": "catalog:",
    "radash": "catalog:",
    "sass": "catalog:",
    "scule": "catalog:",
    "shiki": "catalog:",
    "shiki-magic-move": "catalog:",
    "simple-git-hooks": "catalog:",
    "three": "catalog:",
    "treemate": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-extra": "catalog:",
    "unocss-preset-scrollbar": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-icons": "catalog:",
    "unplugin-vue": "catalog:",
